# Pasta onde voce joga os .fit exportados do iGPSPORT
DATA_DIR=../data
DATABASE_URL=sqlite:///./igpsport.db

# Seu FTP em watts (usado para IF / TSS / PMC). Ajuste quando refizer o teste.
FTP_WATTS=220
HR_MAX=190
HR_REST=55

# Peso do ciclista (com roupa e mochila). Usado para estimar potencia por fisica
# quando o treino nao tem potenciometro - sem isso nao ha TSS nem curva de potencia.
RIDER_WEIGHT_KG=75
# Peso usado quando a bike do treino ainda nao foi identificada.
DEFAULT_BIKE_WEIGHT_KG=12

# --- iGPSPORT Open Platform (so preencha se sua aplicacao for aprovada) ---
IGPSPORT_ENABLED=false
IGPSPORT_CLIENT_ID=
IGPSPORT_CLIENT_SECRET=
IGPSPORT_REDIRECT_URI=http://localhost:8000/api/igpsport/callback
IGPSPORT_AUTH_URL=
IGPSPORT_TOKEN_URL=
IGPSPORT_API_BASE=
